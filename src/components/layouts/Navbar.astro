---
// Navbar layout component
// TODO: Implement navigation bar content and behavior

import { navbarLinks } from './styles/navbarLinks';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  // Special case: "Experiences" tab points to the Professional page,
  // but should appear active for any /experiences/* route.
  if (href === '/experiences/professional') {
    const base = '/experiences';
    return currentPath === base || currentPath.startsWith(base + '/');
  }

  return currentPath === href || currentPath.startsWith(href + '/');
};
const baseLinkClasses =
  'inline-flex w-full items-center justify-center rounded-t-2xl px-6 py-3 border text-[0.9rem] tracking-[0.14em] uppercase transition-colors duration-150 border-transparent md:w-auto md:justify-start';
---

<header class="md:col-start-2 md:row-start-1 px-3 pt-5 pb-0 md:px-8 bg-gradient-to-r from-slate-900/95 to-slate-900/85 border-b border-transparent backdrop-blur-xl">
  <div class="flex items-center justify-center gap-4">
    <button
      type="button"
      data-navbar-prev
      aria-label="Scroll tabs left"
      class="hidden h-8 w-8 items-center justify-center rounded-full border border-[color:var(--border-subtle)] bg-slate-900/70 text-sm text-[color:var(--text-muted)] transition-opacity opacity-0 pointer-events-none md:inline-flex"
    >
      ‹
    </button>

    <nav
      class="navbar-strip flex min-w-0 flex-1 flex-col items-stretch justify-center gap-1 px-1 text-[0.9rem] tracking-[0.14em] uppercase text-[color:var(--text-muted)] md:flex-row md:items-center md:flex-nowrap md:gap-6 md:px-4 md:overflow-x-auto md:whitespace-nowrap"
      aria-label="Primary"
      data-navbar-links
    >
      {navbarLinks.map((link) => (
        <a
          href={link.href}
          class={`${baseLinkClasses} ${
            isActive(link.href)
              ? '-mb-px border-x border-t border-[color:var(--border-subtle)] border-b-transparent bg-[color:var(--bg-app)] text-[color:var(--text-main)] font-semibold underline underline-offset-4 decoration-[color:var(--accent)]'
              : 'text-[color:var(--text-muted)] hover:text-[color:var(--text-main)] hover:border-slate-600/70 hover:bg-slate-900/40'
          }`}
        >
          <span class={isActive(link.href) ? 'navbar-tab-label-active' : ''}>
            {link.label}
          </span>
        </a>
      ))}
    </nav>

    <button
      type="button"
      data-navbar-next
      aria-label="Scroll tabs right"
      class="hidden h-8 w-8 items-center justify-center rounded-full border border-[color:var(--border-subtle)] bg-slate-900/70 text-sm text-[color:var(--text-muted)] transition-opacity opacity-0 pointer-events-none md:inline-flex"
    >
      ›
    </button>
  </div>
</header>

<script>
  const SCROLL_KEY = 'global-shell-scroll-y';

  const setupNavbarScroll = () => {
    const nav = document.querySelector('[data-navbar-links]');
    const prev = document.querySelector('[data-navbar-prev]');
    const next = document.querySelector('[data-navbar-next]');

    if (!nav || !prev || !next) return;

    window.__navbarScrollCleanup?.();

    const desktopMedia = window.matchMedia('(min-width: 768px)');
    let frameId = 0;

    const updateButtons = () => {
      frameId = 0;

      if (!desktopMedia.matches) {
        prev.disabled = true;
        next.disabled = true;
        prev.classList.add('opacity-0', 'pointer-events-none');
        next.classList.add('opacity-0', 'pointer-events-none');
        return;
      }

      const maxScroll = nav.scrollWidth - nav.clientWidth;
      const scrollable = maxScroll > 1;
      const atStart = nav.scrollLeft <= 0;
      const atEnd = nav.scrollLeft >= maxScroll - 1;

      const showPrev = scrollable && !atStart;
      const showNext = scrollable && !atEnd;

      prev.disabled = !showPrev;
      next.disabled = !showNext;

      prev.classList.toggle('opacity-0', !showPrev);
      prev.classList.toggle('pointer-events-none', !showPrev);
      next.classList.toggle('opacity-0', !showNext);
      next.classList.toggle('pointer-events-none', !showNext);
    };

    const scheduleUpdate = () => {
      if (!frameId) frameId = window.requestAnimationFrame(updateButtons);
    };

    const scrollByStep = (direction) => {
      const items = nav.querySelectorAll('a');
      if (!items.length) return;

      let step = items[0].getBoundingClientRect().width;
      if (items.length > 1) {
        const first = items[0].getBoundingClientRect();
        const second = items[1].getBoundingClientRect();
        step = Math.abs(second.left - first.left);
      }

      nav.scrollBy({ left: direction * step, behavior: 'smooth' });
    };

    const onPrevClick = () => scrollByStep(-1);
    const onNextClick = () => scrollByStep(1);
    const onNavigationClick = (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('a')) return;

      const y = window.scrollY || document.documentElement.scrollTop || 0;
      try {
        window.sessionStorage.setItem(SCROLL_KEY, String(y));
      } catch {
        // Ignore unavailable storage.
      }
    };

    prev.addEventListener('click', onPrevClick);
    next.addEventListener('click', onNextClick);
    nav.addEventListener('scroll', scheduleUpdate, { passive: true });
    nav.addEventListener('click', onNavigationClick);

    const resizeObserver = new ResizeObserver(scheduleUpdate);
    resizeObserver.observe(nav);
    desktopMedia.addEventListener('change', scheduleUpdate);

    window.__navbarScrollCleanup = () => {
      if (frameId) window.cancelAnimationFrame(frameId);
      resizeObserver.disconnect();
      desktopMedia.removeEventListener('change', scheduleUpdate);
      prev.removeEventListener('click', onPrevClick);
      next.removeEventListener('click', onNextClick);
      nav.removeEventListener('scroll', scheduleUpdate);
      nav.removeEventListener('click', onNavigationClick);
    };

    scheduleUpdate();
  };

  if (typeof window !== 'undefined' && !window.__navbarScrollLifecycleSetup) {
    window.__navbarScrollLifecycleSetup = true;
    document.addEventListener('astro:page-load', setupNavbarScroll);
  }
</script>
