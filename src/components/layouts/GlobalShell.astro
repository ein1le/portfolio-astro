---
// GlobalShell layout component
// TODO: Wire up layout styles and responsive behavior

import '../../styles/global.css';
import '../../styles/theme.css';
import '../../styles/base.css';
import '../../styles/components.css';
import '../../styles/utilities.css';
import Navbar from './Navbar.astro';
import LeftSidebar from './LeftSidebar.astro';
import RightSidebar from './RightSidebar.astro';
// TODO: Import and use TSS style definitions from the styles/ directory
---

<div
  id="global-shell-root"
  class="flex flex-col gap-y-16 md:gap-y-0 min-h-screen md:h-screen md:overflow-hidden bg-[color:var(--bg-app)] text-[color:var(--text-main)] md:grid md:grid-cols-[24rem_minmax(0,_1fr)_24rem] md:grid-rows-[auto_1fr]"
>

  <LeftSidebar />
  <Navbar />
  <main class="md:col-start-2 md:row-start-2 flex flex-col flex-1 min-h-0">
    <slot />
  </main>
  <RightSidebar />
</div>

<script type="module" src="/scripts/themeToggle.js"></script>
<script type="module" src="/scripts/resize.js"></script>
