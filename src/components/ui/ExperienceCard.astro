---
// Generic Experience card
// Inherits from Card and is used by more specific experience cards.
//
// Experience data template for copy-paste:
// {
//   title: '',
//   role: '',
//   dates: '',
//   location: '',
//   skills: [],
//   languages: [],
//   description: '',
//   links: [{ label: '', url: '' }],
//   logo: '',
//   contributors: [],
//   subroles: [
//     {
//       role: '',
//       description: '',
//       dates: '',
//       skills: [],
//       links: [{ label: '', url: '' }],
//       contributors: [],
//     },
//   ],
// }

import Card from './Card.astro';
import Button from './Button.astro';
import Bubble from './Bubble.astro';
import { Icon } from 'astro-icon/components';
import { getIconName } from '../../icons/iconMap';

// Tool / language logos for academic experiences (bundled as URLs)
import abaqusLogo from '../../icons/abaqus.png?url';
import alphaExpressionLogo from '../../icons/alphaexpression.png?url';
import ansysLogo from '../../icons/ansys.png?url';
import apacheLogo from '../../icons/apache.png?url';
import awsLogo from '../../icons/aws.png?url';
import bloombergLogo from '../../icons/bloomberg-media.png?url';
import digimuLogo from '../../icons/DIGIMU.png?url';
import fusion360Logo from '../../icons/fusion360.png?url';
import langchainLogo from '../../icons/langchain.png?url';
import lovableLogo from '../../icons/lovable.png?url';
import matlabLogo from '../../icons/matlab.png?url';
import nvidiaLogo from '../../icons/nvidia.png?url';
import opencvLogo from '../../icons/opencv.png?url';
import quantconnectLogo from '../../icons/quantconnect.png?url';
import starCcmLogo from '../../icons/star-ccm.png?url';
import streamlitLogo from '../../icons/streamlit.png?url';
import supabaseLogo from '../../icons/supabase.png?url';
import tableauLogo from '../../icons/tableau.png?url';
import tensorflowLogo from '../../icons/tensorflow.png?url';
import vbaLogo from '../../icons/VBA.png?url';
import websimLogo from '../../icons/websim.jpg?url';
import wixLogo from '../../icons/wix.png?url';
import firebaseLogo from '../../icons/firebase-me.png?url';

interface ExperienceLink {
  label: string;
  url: string;
  type?: 'GitHub' | 'Website' | 'LinkTree' | 'Award' | 'External' | 'Instagram' | string;
}

interface ExperienceSubrole {
  role: string;
  dates?: string;
  description?: string;
  skills?: string[];
  contributors?: string[];
  links?: ExperienceLink[];
}

type ExperienceType =
  | 'Contract'
  | 'Full-time'
  | 'Student Role'
  | 'Internship'
  | 'Researcher'
  | string;

interface Props {
  title: string;
  role: string;
  organisation?: string;
  location: string;
  dates: string;
  description: string;
  logo?: string;
  type?: ExperienceType;
  links?: ExperienceLink[];
  skills?: string[];
  languages?: string[];
  subroles?: ExperienceSubrole[];
  contributors?: string[];
}

const {
  title,
  role,
  organisation,
  location,
  dates,
  description,
  logo,
  // type is accepted but no longer rendered as a badge
  type,
  links = [],
  skills = [],
  languages = [],
  subroles = [],
  contributors = [],
} = Astro.props as Props;

const languageIconKeyMap: Record<string, string> = {
  // Languages / runtimes
  Python: 'python',
  'C++': 'cpp',
  JavaScript: 'javascript',

  // Frameworks / libraries
  React: 'react',

  // These have bespoke raster logos instead of icon font
  // AWS, Supabase, OpenCV, Wix, Firebase all use PNG/JPG logos below.
};

const languageLogoMap: Record<string, string> = {
  // Cloud / infra
  AWS: awsLogo,
  Apache: apacheLogo,
  Supabase: supabaseLogo,

  // CAD / simulation
  'Autodesk Fusion360': fusion360Logo,
  'Star CCM+': starCcmLogo,
  'Abaqus CAE': abaqusLogo,
  DIGIMU: digimuLogo,
  'Ansys Edupack': ansysLogo,

  // Analytics / quant tooling
  Bloomberg: bloombergLogo,
  Streamlit: streamlitLogo,
  QuantConnect: quantconnectLogo,

  // ML / AI stacks
  TensorFlow: tensorflowLogo,
  Nvidia: nvidiaLogo,
  LangChain: langchainLogo,
  Lovable: lovableLogo,
  OpenCV: opencvLogo,

  // Quant research platforms
  'Alpha Expression': alphaExpressionLogo,
  WebSim: websimLogo,

  // Math / programming
  MATLAB: matlabLogo,

  // Web platforms
  Wix: wixLogo,
  Firebase: firebaseLogo,

  // BI / analytics tooling
  VBA: vbaLogo,
  Tableau: tableauLogo,
};

const getLanguageIconName = (lang: string): string | null => {
  const key = languageIconKeyMap[lang];
  return key ? getIconName(key as any) : null;
};

const getLinkVisuals = (type?: string) => {
  switch (type) {
    case 'GitHub':
      return {
        buttonClass:
          'border-black bg-black/70 text-white hover:bg-black hover:border-black',
        iconName: 'github',
      };
    case 'Website':
      return {
        buttonClass:
          '!border-sky-400 !bg-sky-500/20 !text-sky-100 hover:!bg-sky-500/35 hover:!border-sky-300',
        iconName: 'web',
      };
    case 'LinkTree':
      return {
        buttonClass:
          '!border-emerald-400 !bg-emerald-500/20 !text-emerald-100 hover:!bg-emerald-500/35 hover:!border-emerald-300',
        iconName: 'linktree',
      };
    case 'Award':
      return {
        buttonClass:
          '!border-amber-400 !bg-amber-500/20 !text-amber-50 hover:!bg-amber-500/35 hover:!border-amber-300',
        iconName: 'star',
      };
    case 'Instagram':
      return {
        buttonClass:
          '!border-pink-400 !bg-pink-500/20 !text-pink-100 hover:!bg-pink-500/35 hover:!border-pink-300',
        iconName: 'instagram',
      };
    default:
      return {
        buttonClass:
          'border-purple-400 bg-purple-500/20 text-purple-50 hover:bg-purple-500/35 hover:border-purple-300',
        iconName: 'external-link',
      };
  }
};
---

<Card>
  <div class="flex flex-col gap-2 px-2 md:px-3 text-sm text-[color:var(--text-main)]">
    <div class="flex flex-wrap items-start gap-3">
      {logo ? (
        <div class="h-12 w-12 shrink-0 overflow-hidden rounded-md border border-purple-400/40 bg-slate-900">
          <img
            src={logo}
            alt={`${title} logo`}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      ) : title === 'YSG Group Co.' ? (
        <div class="h-12 w-12 shrink-0 rounded-md border border-purple-400/40 bg-white flex items-center justify-center">
          <span class="text-[0.8rem] font-semibold tracking-[0.16em] text-slate-900">
            YSG
          </span>
        </div>
      ) : null}

      <div class="flex min-w-0 flex-1 flex-col gap-1">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div class="min-w-0 max-w-[65%] space-y-0.5 md:space-y-1">
            <p class="text-[1rem] font-semibold tracking-[0.12em] uppercase break-words">
              {title}
            </p>
            <h2 class="text-[0.9rem] tracking-[0.12em] uppercase break-words text-[color:var(--text-main)]">
              {role}
            </h2>
            {organisation && (
              <p class="mt-0.5 md:mt-1 text-[0.85rem] font-semibold tracking-[0.12em] uppercase break-words text-[color:var(--accent)]">
                {organisation}
              </p>
            )}
          </div>
          <div class="flex flex-col items-end gap-1 text-right">
            <p class="text-[0.78rem] text-[color:var(--text-muted)]">
              {dates}
            </p>
            <p class="text-[0.78rem] text-[color:var(--text-muted)]">
              {location}
            </p>
          </div>
        </div>

        {(skills.length > 0 || languages.length > 0) && (
          <div class="mt-1 flex flex-wrap items-center justify-between gap-2 text-[0.75rem] text-[color:var(--text-muted)]">
            {skills.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {skills.map((skill) => (
                  <span class="inline-flex items-center rounded-full border border-slate-500/40 bg-slate-950/40 px-2 py-0.5">
                    {skill}
                  </span>
                ))}
              </div>
            )}

            {languages.length > 0 && (
              <div class="flex flex-wrap gap-1 sm:ml-auto sm:justify-end">
                {languages.map((lang) => {
                  const logoSrc = languageLogoMap[lang];
                  const iconName = getLanguageIconName(lang);

                  return (
                    <span class="group inline-flex items-center justify-center">
                      <Bubble
                        size="md"
                        logo={logoSrc}
                        iconName={iconName || undefined}
                        text={!logoSrc && !iconName ? lang[0] : undefined}
                        alt={lang}
                      />
                    </span>
                  );
                })}
              </div>
            )}
          </div>
        )}

        {contributors.length > 0 && (
          <div class="mt-1 flex flex-wrap items-center gap-2 text-[0.75rem] text-[color:var(--text-muted)]">
            <span class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-main)]">
              Contributors
            </span>
            <div class="flex flex-wrap gap-2">
              {contributors.map((name) => (
                <span class="group inline-flex items-center justify-center">
                  <Bubble size="md" name={name} />
                </span>
              ))}
            </div>
          </div>
        )}

        {description && (
          <p class="mt-1 text-[0.8rem] leading-relaxed text-[color:var(--text-muted)]">
            {description}
          </p>
        )}

        {subroles.length > 0 && (
          <div class="mt-3 space-y-3">
            {subroles.map((sub) => (
              <div class="rounded-md bg-slate-950/40 px-3 py-3">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <p class="text-[0.8rem] font-semibold tracking-[0.1em] uppercase text-[color:var(--text-main)]">
                    {sub.role}
                  </p>
                  {sub.dates && (
                    <p class="text-[0.72rem] text-[color:var(--text-muted)]">
                      {sub.dates}
                    </p>
                  )}
                </div>

                {sub.description && (
                  <p class="mt-1 text-[0.78rem] leading-relaxed text-[color:var(--text-muted)]">
                    {sub.description}
                  </p>
                )}

                {sub.skills && sub.skills.length > 0 && (
                  <div class="mt-2 flex flex-wrap gap-2 text-[0.72rem] text-[color:var(--text-muted)]">
                    {sub.skills.map((skill) => (
                      <span class="inline-flex items-center rounded-full border border-slate-500/40 bg-slate-950/40 px-2 py-0.5">
                        {skill}
                      </span>
                    ))}
                  </div>
                )}

                {sub.contributors && sub.contributors.length > 0 && (
                  <div class="mt-2 flex items-center gap-2">
                    <span class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-main)]">
                      Contributors
                    </span>
                    <div class="flex flex-wrap gap-1.5">
                      {sub.contributors.map((person) => (
                        <span class="group inline-flex items-center justify-center">
                          <Bubble size="sm" name={person} />
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {sub.links && sub.links.length > 0 && (
                  <div class="mt-2 flex flex-wrap justify-end gap-2 text-[0.72rem] text-[color:var(--text-muted)]">
                    {sub.links.map((link) => {
                      const { buttonClass, iconName } = getLinkVisuals(link.type);

                      return (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-block"
                        >
                          <Button class={`px-2.5 py-1 text-[0.7rem] ${buttonClass}`}>
                            <span class="flex items-center gap-1.5">
                              <Icon name={getIconName(iconName as any)} class="h-3 w-3" />
                              <span>{link.label}</span>
                            </span>
                          </Button>
                        </a>
                      );
                    })}
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    {links.length > 0 && (
      <div class="mt-2 flex flex-wrap gap-2 pt-1 text-[0.75rem] text-[color:var(--text-muted)] sm:justify-end sm:ml-auto">
        {links.map((link) => {
          const { buttonClass, iconName } = getLinkVisuals(link.type);

          return (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block"
            >
              <Button class={`px-3 py-1 text-[0.7rem] ${buttonClass}`}>
                <span class="flex items-center gap-1.5">
                  <Icon name={getIconName(iconName as any)} class="h-3.5 w-3.5" />
                  <span>{link.label}</span>
                </span>
              </Button>
            </a>
          );
        })}
      </div>
    )}
  </div>
</Card>
