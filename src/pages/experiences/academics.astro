---
import GlobalShell from '../../components/layouts/GlobalShell.astro';
import AppHead from '../_app-head.astro';
import ExperiencesSubnav from '../../components/layouts/ExperiencesSubnav.astro';
import ExperienceCard from '../../components/ui/ExperienceCard.astro';
import { academicExperiences } from '../../data/academicExperiences';

const priorityOrder = [
  'Quantitative Engineer',
  'Chief Information Officer',
  'Project Advisor',
  'Director of Technology',
  'BRAINยฎ Researcher',
];

const getPriority = (title: string) => {
  const idx = priorityOrder.indexOf(title);
  return idx === -1 ? Number.MAX_SAFE_INTEGER : idx;
};

const sortedAcademicExperiences = academicExperiences
  .map((exp, index) => ({ exp, index }))
  .sort((a, b) => {
    const pa = getPriority(a.exp.title);
    const pb = getPriority(b.exp.title);

    if (pa !== pb) {
      return pa - pb;
    }

    // Preserve original order for experiences with the same priority
    return a.index - b.index;
  })
  .map(({ exp }) => exp);
---

<html lang="en">
  <head>
    <AppHead />
  </head>
  <body>
    <GlobalShell>
      <div class="flex flex-col md:flex-1 md:min-h-0">
        <ExperiencesSubnav />
        <div class="relative md:flex-1 md:min-h-0">
          <div class="pointer-events-none absolute inset-x-0 top-0 z-10 h-10 bg-gradient-to-b from-[color:var(--bg-app)] to-transparent hidden md:block"></div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-10 bg-gradient-to-t from-[color:var(--bg-app)] to-transparent hidden md:block"></div>

          <section class="scroll-y-area mx-auto flex w-full max-w-none flex-col gap-6 px-3 pt-4 md:h-full md:overflow-y-auto md:px-4 md:pt-6">
            <div class="relative">
              <div class="absolute left-[1.25rem] top-0 bottom-0 border-l-2 border-purple-500/70"></div>

              <div class="space-y-6 pb-8">
                {sortedAcademicExperiences.map((exp) => (
                  <div class="relative flex gap-6">
                    <div class="flex w-10 items-center justify-center">
                      <div class="relative">
                        <span class="inline-flex h-4 w-4 items-center justify-center rounded-full border-2 border-purple-400 bg-[color:var(--bg-app)] shadow-sm shadow-purple-500/40"></span>
                      </div>
                    </div>

                    <div class="flex-1">
                      <ExperienceCard
                        title={exp.title}
                        role={exp.role}
                        organisation={exp.organisation}
                        dates={exp.dates}
                        type={exp.type}
                        description={exp.description}
                        skills={exp.skills}
                        languages={exp.languages}
                        location={exp.location}
                        logo={exp.logo}
                        subroles={exp.subroles}
                        contributors={exp.contributors}
                        links={exp.links}
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </section>
        </div>
      </div>
    </GlobalShell>
  </body>
</html>
