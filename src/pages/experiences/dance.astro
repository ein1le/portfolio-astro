---
import GlobalShell from '../../components/layouts/GlobalShell.astro';
import AppHead from '../_app-head.astro';
import ExperiencesSubnav from '../../components/layouts/ExperiencesSubnav.astro';
import DanceCard from '../../components/ui/DanceCard.astro';
import { danceExperiences } from '../../data/dance';

// Asymmetrical desktop rhythm (12-column grid):
// row 1: 7/5, row 2: 3/6/3, row 3 overridden to 4/4/4.
const spans = ['span-7', 'span-5', 'span-3', 'span-6', 'span-3', 'span-8', 'span-4'];
const cardSpanOverride: Record<string, string> = {
  DCorps: 'span-3',
  'Legends of Lions': 'span-4',
  'B House Studio': 'span-4',
  'Elevate Studio': 'span-4',
};
---

<html lang="en">
  <head>
    <AppHead />
  </head>
  <body>
    <GlobalShell>
      <ExperiencesSubnav />
      <section class="mx-auto flex w-full flex-col gap-4 px-6 pt-4 md:px-8 md:pt-6">
        <div class="dance-grid">
          {danceExperiences.map((card, index) => (
            <div class={`dance-item ${cardSpanOverride[card.name] ?? spans[index % spans.length]}`}>
              <DanceCard
                name={card.name}
                subtitle={card.subtitle}
                date={card.date}
                logo={card.logo}
                description={card.description}
                links={card.links}
              />
            </div>
          ))}
        </div>
      </section>
    </GlobalShell>
  </body>
</html>

<style>
  .dance-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 220px;
    gap: 1rem;
    width: 100%;
  }

  .dance-item {
    min-width: 0;
    height: 100%;
  }

  .span-3 {
    grid-column: span 3;
  }

  .span-4 {
    grid-column: span 4;
  }

  .span-5 {
    grid-column: span 5;
  }

  .span-6 {
    grid-column: span 6;
  }

  .span-7 {
    grid-column: span 7;
  }

  .span-8 {
    grid-column: span 8;
  }

  .span-12 {
    grid-column: span 12;
  }

  @media (max-width: 1024px) {
    .dance-grid {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-auto-rows: 200px;
    }

    .span-3,
    .span-4,
    .span-5,
    .span-6,
    .span-7,
    .span-8,
    .span-12 {
      grid-column: span 8;
    }
  }

  @media (max-width: 640px) {
    .dance-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 180px;
    }

    .dance-item {
      grid-column: 1 / -1;
    }
  }
</style>

