---
import GlobalShell from '../../components/layouts/GlobalShell.astro';
import AppHead from '../_app-head.astro';
import ExperiencesSubnav from '../../components/layouts/ExperiencesSubnav.astro';
import DanceCard from '../../components/ui/DanceCard.astro';
import { danceExperiences } from '../../data/dance';

// Asymmetrical desktop rhythm (12-column grid) with paired feature rows.
const cardSpanOverride: Record<string, string> = {
  DCorps: 'span-6',
  Hydrogen: 'span-6',
  'Bristol MSNight': 'span-6',
  'T Stage': 'span-6',
  PARADOX: 'span-7',
  KMDC: 'span-5',
  Astris: 'span-3',
  'B House Studio': 'span-6',
  'Elevate Studio': 'span-3',
  Reines: 'span-4',
  'Legends of Lions': 'span-4',
  '44 City': 'span-4',
};

const danceCardOrder = [
  'DCorps',
  'Hydrogen',
  'Bristol MSNight',
  'T Stage',
  'PARADOX',
  'KMDC',
  'Astris',
  'B House Studio',
  'Elevate Studio',
  'Reines',
  'Legends of Lions',
  '44 City',
];
const orderedDanceExperiences = [...danceExperiences].sort((a, b) => {
  const aIndex = danceCardOrder.indexOf(a.name);
  const bIndex = danceCardOrder.indexOf(b.name);
  const aPriority = aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex;
  const bPriority = bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex;

  return aPriority - bPriority;
});
---

<html lang="en">
  <head>
    <AppHead />
  </head>
  <body>
    <GlobalShell>
      <div class="flex flex-col md:flex-1 md:min-h-0">
        <ExperiencesSubnav />
        <div class="relative md:flex-1 md:min-h-0">
          <div class="pointer-events-none absolute inset-x-0 top-0 z-10 h-10 bg-gradient-to-b from-[color:var(--bg-app)] to-transparent hidden md:block"></div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-10 bg-gradient-to-t from-[color:var(--bg-app)] to-transparent hidden md:block"></div>

          <section class="scroll-y-area mx-auto flex w-full flex-col gap-4 px-6 pt-4 pb-6 md:h-full md:overflow-y-auto md:px-8 md:pt-6">
            <div class="dance-grid">
              {orderedDanceExperiences.map((card, index) => (
                <div
                  class={`dance-item experience-card-animate ${cardSpanOverride[card.name] ?? 'span-12'}`}
                  style={`animation-delay: ${index * 90}ms;`}
                >
                  <DanceCard
                    name={card.name}
                    subtitle={card.subtitle}
                    date={card.date}
                    logo={card.logo}
                    description={card.description}
                    links={card.links}
                  />
                </div>
              ))}
            </div>
          </section>
        </div>
      </div>
    </GlobalShell>
  </body>
</html>

<style>
  .dance-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 220px;
    gap: 1rem;
    width: 100%;
  }

  .dance-item {
    min-width: 0;
    height: 100%;
  }

  .span-3 {
    grid-column: span 3;
  }

  .span-4 {
    grid-column: span 4;
  }

  .span-5 {
    grid-column: span 5;
  }

  .span-6 {
    grid-column: span 6;
  }

  .span-7 {
    grid-column: span 7;
  }

  .span-8 {
    grid-column: span 8;
  }

  .span-12 {
    grid-column: span 12;
  }

  @media (max-width: 1024px) {
    .dance-grid {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-auto-rows: 200px;
    }

    .span-3,
    .span-4,
    .span-5,
    .span-6,
    .span-7,
    .span-8,
    .span-12 {
      grid-column: span 8;
    }
  }

  @media (max-width: 640px) {
    .dance-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 180px;
    }

    .dance-item {
      grid-column: 1 / -1;
    }
  }
</style>
