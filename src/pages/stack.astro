---
import GlobalShell from '../components/layouts/GlobalShell.astro';
import AppHead from './_app-head.astro';
import { StackGrid, IconButton } from '../components/ui';
import { stackGroups, certifications } from '../data/stack';
---

<html lang="en">
  <head>
    <AppHead />
  </head>
  <body>
    <GlobalShell>
      <div class="flex flex-col md:flex-1 md:min-h-0">
        <div class="relative md:flex-1 md:min-h-0">
          <div class="pointer-events-none absolute inset-x-0 top-0 z-10 h-10 bg-gradient-to-b from-[color:var(--bg-app)] to-transparent hidden md:block"></div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-10 bg-gradient-to-t from-[color:var(--bg-app)] to-transparent hidden md:block"></div>

          <section class="scroll-y-area mx-auto flex w-full max-w-none flex-col gap-6 px-6 pt-6 md:h-full md:overflow-y-auto md:px-8 md:pt-8">
            <StackGrid groups={stackGroups} />

            {certifications.length > 0 && (
              <div class="mt-6 mb-6 flex flex-col gap-3 border-t border-[color:var(--border-subtle)] pt-5 pb-4">
                <p class="subtitle">
                  Certifications
                </p>
                <div class="flex flex-wrap items-center gap-4">
                  {certifications.map((cert) => (
                    <span class="group relative inline-flex">
                      <IconButton
                        href={cert.link}
                        logo={cert.logo}
                        alt={cert.name}
                        size="lg"
                      />
                      <span class="pointer-events-none absolute left-1/2 top-full z-20 mt-2 w-max max-w-[14rem] -translate-x-1/2 rounded-md border border-[color:var(--border-subtle)] bg-slate-950/95 px-3 py-2 text-center text-[0.68rem] leading-tight text-[color:var(--text-main)] opacity-0 shadow-md shadow-black/40 transition-all duration-150 group-hover:opacity-100">
                        <span class="block font-semibold uppercase tracking-[0.1em]">
                          {cert.name}
                        </span>
                        <span class="mt-1 block text-[color:var(--text-muted)]">
                          {cert.date}
                        </span>
                      </span>
                    </span>
                  ))}
                </div>
              </div>
            )}
          </section>
        </div>
      </div>
    </GlobalShell>
  </body>
</html>
