---
import GlobalShell from '../components/layouts/GlobalShell.astro';
import AppHead from './_app-head.astro';
import { EducationCard } from '../components/ui';
import { educationEntries } from '../data/education';
---

<html lang="en">
  <head>
    <AppHead />
  </head>
  <body>
    <GlobalShell>
      <div class="flex flex-col md:flex-1 md:min-h-0">
        <div class="relative md:flex-1 md:min-h-0">
          <div class="pointer-events-none absolute inset-x-0 top-0 z-10 h-10 bg-gradient-to-b from-[color:var(--bg-app)] to-transparent hidden md:block"></div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-10 bg-gradient-to-t from-[color:var(--bg-app)] to-transparent hidden md:block"></div>

          <section class="scroll-y-area mx-auto flex w-full max-w-none flex-col gap-4 px-3 pt-4 md:h-full md:overflow-y-auto md:px-4 md:pt-6">
            {educationEntries.map((entry, index) => (
              <div class="edu-card" style={`animation-delay: ${index * 90}ms;`}>
                <EducationCard
                  title={entry.subheader}
                  institution={entry.title}
                  period={entry.date}
                  location={entry.location}
                  description={entry.grade}
                  image={entry.image}
                  modules={entry.modules}
                  awards={entry.awards}
                  publications={entry.publications}
                  transcriptUrls={entry.transcriptUrls}
                />
              </div>
            ))}
          </section>
        </div>
      </div>
    </GlobalShell>
  </body>
</html>
